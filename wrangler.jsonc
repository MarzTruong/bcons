// Cloudflare Workers (Workers Builds nối GitHub): đăng landing page tĩnh.
// Build command: node engine/landing/build.mjs   ·   Deploy command: npx wrangler deploy
// Tên phải trùng "Project name" trên Cloudflare.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bcons-central-park",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./engine/landing/dist/bcons-central-park",
    "not_found_handling": "404-page"
  }
}
