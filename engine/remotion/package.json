{
  "name": "bcons-remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/google-fonts": "^4.0.540",
    "@remotion/media": "^4.0.540",
    "@remotion/media-parser": "^4.0.540",
    "@turf/turf": "^7.4.0",
    "mapbox-gl": "^3.34.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc && node scripts/check-spec.mjs --all",
    "render:drive": "node scripts/render-drive.mjs",
    "voice": "node --env-file=.env scripts/generate-voice.mjs",
    "sfx": "node --env-file=.env scripts/tao-sfx.mjs",
    "gemini": "node --env-file=.env scripts/gemini.mjs",
    "phu-de": "node scripts/phu-de.mjs",
    "storyboard": "node scripts/storyboard.mjs",
    "test": "node --test \"tests/*.test.mjs\" \"../automation/*.test.mjs\" \"../landing/*.test.mjs\"",
    "check:spec": "node scripts/check-spec.mjs",
    "check:mapbox": "node scripts/check-mapbox.mjs",
    "geo:fetch": "node scripts/geo-fetch.mjs",
    "geo:derive": "node scripts/geo-derive.mjs",
    "still": "node scripts/with-env.mjs remotion still",
    "check:caption": "node scripts/caption-cli.mjs check",
    "duyet:caption": "node scripts/caption-cli.mjs duyet-caption",
    "duyet:video": "node scripts/caption-cli.mjs duyet-video",
    "send:telegram": "node scripts/send-telegram.mjs",
    "telegram:chat-id": "node scripts/telegram-chat-id.mjs",
    "bot": "node scripts/bot/bot.mjs",
    "landing": "node ../landing/build.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
